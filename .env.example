# ─────────────────────────────────────────────────────────────────────────────
# HKLV Dashboard Agent — environment template
#
# Copy this file to `.env` and fill in the real values ON THE MACHINE THAT RUNS
# THE AGENT. The `.env` file is git-ignored and must NEVER be committed.
# Do not paste these secrets into chat or share them — treat them as passwords.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dashboard login ──────────────────────────────────────────────────────────
# Your admin login for https://hangeul.com.bd/admin
HKLV_ADMIN_USER=
HKLV_ADMIN_PASS=

# Base URL of the admin panel (no trailing slash) and the login page path.
HKLV_BASE_URL=https://hangeul.com.bd/admin
HKLV_LOGIN_PATH=login.php

# Login form selectors — only change these if the defaults don't match the real
# login page (run once with HKLV_HEADLESS=false to see the form).
# HKLV_SEL_USER=input[name="username"], input[type="email"], #username
# HKLV_SEL_PASS=input[name="password"], input[type="password"], #password
# HKLV_SEL_SUBMIT=button[type="submit"], input[type="submit"], button

# ── AI brain (Groq) ──────────────────────────────────────────────────────────
GROQ_API_KEY=
# Ordered model chain: primary first, fallbacks after (comma-separated).
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TEMPERATURE=0.2

# ── Telegram bot ─────────────────────────────────────────────────────────────
# Create a bot with @BotFather to get the token; get your numeric id from
# @userinfobot. The bot only obeys messages from TELEGRAM_OWNER_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# ── Engine / runtime ─────────────────────────────────────────────────────────
# playwright (default, recommended) or selenium (fallback).
HKLV_DRIVER=playwright
# true = no visible window (default). Set false for the first login / OTP.
HKLV_HEADLESS=true
# Where sessions, snapshots and the audit log are stored (git-ignored).
HKLV_DATA_DIR=data
# LOG_LEVEL=info   # debug|info|warn|error

# ── Offline / dry-run ────────────────────────────────────────────────────────
# Point this at a saved dashboard HTML file to run the whole pipeline with no
# credentials (used by `npm run agent:brief` for testing). Leave empty for live.
# HKLV_FIXTURE=fixtures/dashboard.sample.html

# ── Action selector overrides (optional) ─────────────────────────────────────
# Only needed if the agent can't find a control on an action page.
# HKLV_SEL_SEND_REMINDERS=
# HKLV_SEL_NOTICE_TITLE=input[name="title"]
# HKLV_SEL_NOTICE_MSG=textarea[name="message"]
# HKLV_SEL_NOTICE_SUBMIT=
