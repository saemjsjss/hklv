{
  "name": "hklv",
  "version": "1.0.0",
  "description": "Browser automation and end-to-end testing with Playwright and Selenium (TypeScript).",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:pw": "playwright test",
    "test:pw:headed": "playwright test --headed",
    "pw:report": "playwright show-report",
    "test:selenium": "tsx selenium/example.ts",
    "driver:chrome": "node scripts/fetch-chromedriver.mjs",
    "typecheck": "tsc --noEmit",
    "agent:selftest": "tsx src/cli/selftest.ts",
    "agent:login": "tsx src/cli/login.ts",
    "agent:brief": "tsx src/cli/brief.ts",
    "agent:serve": "tsx src/cli/serve.ts",
    "agent:morning": "tsx src/schedule/morning.ts"
  },
  "keywords": [
    "playwright",
    "selenium",
    "testing",
    "automation",
    "e2e",
    "typescript"
  ],
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "26.2.0",
    "@types/selenium-webdriver": "4.35.6",
    "selenium-webdriver": "4.47.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
