# Hanyang IEI agency application bot — configuration
# Copy to `.env` and adjust. Nothing here is secret except, optionally, an
# agency login if the portal ever requires one.

# The agency application entry URL (the flow starts here).
HY_URL=https://portal.hanyang.ac.kr/haksa/wons/wonsH.do?yim=1

# Browser: use the real Chrome installed on this machine.
# Leave HY_CHANNEL=chrome for your PC; the bot falls back to bundled Chromium
# if Chrome isn't found (e.g. in CI).
HY_CHANNEL=chrome
HY_HEADLESS=false
HY_SLOWMO=0

# Spreadsheet + files.
HY_TEMPLATE=Hanyang_Students_Template.xlsx
HY_UPLOADS_DIR=uploads
HY_OUTPUT_DIR=output
# Data rows start on this row (row 3 is the sample; real students from row 4).
HY_DATA_START=4

# Safety: dry run by default — fills every field but does NOT click final submit.
# Set HY_SUBMIT=true only when you're ready to actually submit.
HY_SUBMIT=false
# When submitting, skip anyone already recorded as submitted (no double-submits).
HY_SKIP_SUBMITTED=true
# Visible text of the form's final submit button.
HY_SUBMIT_TEXT=Save & Submit

# Optional filters when running.
# HY_ONLY=saem.rahman@example.com   # only this student (matches email or folder)
# HY_LIMIT=1                        # process at most N students

# Only if the portal requires an agency login before the form:
# HY_LOGIN_USER=
# HY_LOGIN_PASS=
